# Credenciais do Watson Assistant (pegue no IBM Cloud > seu assistant > API details)
WATSON_ASSISTANT_API_KEY=your_api_key_here
WATSON_ASSISTANT_URL=https://api.us-south.assistant.watson.cloud.ibm.com/instances/xxxx
WATSON_ASSISTANT_ID=your_assistant_id_here
WATSON_ASSISTANT_VERSION=2021-06-14

# Config do Flask
FLASK_PORT=5000
FLASK_DEBUG=True
